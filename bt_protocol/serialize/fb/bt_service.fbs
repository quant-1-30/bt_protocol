// idl file

namespace Flat;

// base frame

table Calendar {
    tz_info: string (id: 0);
    date: [int] (id: 1);
}

table Instrument {
  sid: string (id: 0);
  region: string (id: 1);
  first_trading: int (id: 2);
  delist: int (id: 3);
}

table Line {
  sid: string (id: 0);
  open: double (id: 1);
  high: double (id: 2);
  low: double (id: 3);
  close: double (id: 4);
  volume: long (id: 5);
  amount: double (id: 6);
}

table Adjustment {
    sid: string (id: 0);
    register_date: int (id: 1);
    ex_date: int (id: 2);
    share: double (id: 3);
    transfer: double (id: 4);
    interest: double (id: 5);
}

table Rights {
  sid: string (id: 0);
  register_date: int (id: 1);  // fixed typo: was register_data
  ex_date: int (id: 2);
  report_date: int (id: 3);    // aligned with ORM Rightment.report_date
  price: double (id: 4);
  ratio: double (id: 5);
}

// struct frame 

table TickFrame {
  ticker: int (id: 0);
  frame: [Line] (id: 1);
}

table AdjFrame {
  ticker: int (id: 0);
  adj: [Adjustment] (id: 1);  // fixed self-reference; element type is Adjustment
}

table RightsFrame {
  ticker: int (id: 0);
  rgts: [Rights] (id: 1);  // fixed self-reference; element type is Rights
}

table QuoteRequest {
  start_date: int (id: 0);
  end_date: int (id: 1);
  freq: string (id: 2);
}

// api

rpc_service btDataFeed {
    get_calendar (QuoteRequest): Calendar; 
    replay_assets (QuoteRequest): Instrument(streaming);
    replay_datasets (QuoteRequest): TickFrame(streaming);  // fixed: TickerFrame was undefined
    replay_adjs (QuoteRequest): AdjFrame(streaming);
    replay_rights (QuoteRequest): RightsFrame(streaming);
}